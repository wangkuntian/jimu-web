{
  "name": "jimu-web",
  "version": "0.3.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:convert": "swagger2openapi contracts/jimu.swagger.yaml -o contracts/jimu.openapi.yaml --yaml --patch",
    "api:types": "bun run api:convert && openapi-typescript contracts/jimu.openapi.yaml -o src/shared/api/generated.ts",
    "api:check": "bun run api:types && git diff --exit-code -- contracts/jimu.openapi.yaml src/shared/api/generated.ts",
    "hooks:install": "git config core.hooksPath githooks",
    "check": "bun run api:check && bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@tanstack/vue-query": "^5.104.1",
    "element-plus": "^2.14.6",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "~2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "~30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.9",
    "swagger2openapi": "^7.0.8",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "trustedDependencies": [
    "vue-demi"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
